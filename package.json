{
  "name": "supplyos-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src next.config.ts",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:mobile-admin": "npm --prefix mobile-admin run typecheck",
    "check:mobile-driver": "npm --prefix mobile-driver run typecheck",
    "check:mobile": "npm run check:mobile-admin && npm run check:mobile-driver",
    "check:all": "npm run check && npm run check:mobile"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.90.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
